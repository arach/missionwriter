{
  "name": "missionwriter",
  "version": "0.1.0",
  "description": "Agentic Markdown workspace for traceable writing, review, and revision runs.",
  "type": "module",
  "private": true,
  "bin": {
    "mw": "bin/mw.ts"
  },
  "scripts": {
    "mw": "bun bin/mw.ts",
    "serve": "bun bin/mw.ts serve",
    "site:dev": "bun --cwd site dev",
    "site:typecheck": "bun --cwd site typecheck",
    "site:build": "bun --cwd site build"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.13",
    "@openscout/agent-sessions": "0.2.64",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
